NMA_BASE_URL=https://adder.example.com
NMA_SECRET_KEY=replace-with-a-long-random-value
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
NMA_TOKEN_ENCRYPTION_KEY=
NMA_TIDAL_SESSION_FILE=/state/tidal-session.json

NMA_AUTHELIA_ISSUER_URL=https://auth.example.com
NMA_AUTHELIA_CLIENT_ID=navidrome-music-adder
NMA_AUTHELIA_CLIENT_SECRET=
NMA_AUTHELIA_USERS_GROUP=users
NMA_AUTHELIA_ADMIN_GROUP=admins

# Alternative to OIDC when Traefik/Authelia ForwardAuth protects the app.
NMA_PROXY_AUTH_ENABLED=false
NMA_PROXY_AUTH_USER_HEADER=Remote-User
NMA_PROXY_AUTH_GROUPS_HEADER=Remote-Groups
NMA_PROXY_AUTH_TRUSTED_SOURCES=

NMA_NAVIDROME_URL=http://navidrome:4533
NMA_NAVIDROME_USER_HEADER=Remote-User
NMA_TIDARR_URL=http://tidarr:8484
NMA_TIDARR_API_KEY=
# Optional alternative for Tidarr's generated /shared/.tidarr-api-key.
NMA_TIDARR_API_KEY_FILE=

# Optional read-only library fallback. Omit or leave empty for API-only mode.
NMA_MUSIC_PATH=
NMA_WORKER_INTERVAL_SECONDS=5

# Local development only
NMA_DEV_AUTH_BYPASS=false
NMA_DEV_AUTH_USERNAME=testuser
